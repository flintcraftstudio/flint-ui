package templates

import "github.com/flintcraftstudio/flint-ui/components/button"

templ Buttons() {
	<div class="space-y-12">
		@pageHeader("Button", "Solid, outline, and plain buttons driven by the semantic token contract. Pick a Variant (primary / accent / danger / success / warning) or flip Outline/Plain. Any variant can render as an <a> by setting Href, and passes htmx or data attributes through Attrs.")

		@section("Default (primary)", "The zero-value Props renders a primary solid button using the --color-primary token.") {
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{}) {
					Save changes
				}
				@button.Button(button.Props{Disabled: true}) {
					Disabled
				}
			</div>
		}

		@section("Solid variants", "One button per Variant in the token contract. Override the matching CSS variable in your theme to rebrand every button of that variant.") {
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{Variant: button.VariantPrimary}) { Primary }
				@button.Button(button.Props{Variant: button.VariantAccent}) { Accent }
				@button.Button(button.Props{Variant: button.VariantDanger}) { Danger }
				@button.Button(button.Props{Variant: button.VariantSuccess}) { Success }
				@button.Button(button.Props{Variant: button.VariantWarning}) { Warning }
			</div>
		}

		@section("Outline", "Neutral outline tied to the border / foreground / muted tokens — secondary actions.") {
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{Outline: true}) { Outline }
				@button.Button(button.Props{Outline: true, Disabled: true}) { Disabled }
			</div>
		}

		@section("Plain", "Borderless until hovered. Good for in-table row actions and subtle navigation.") {
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{Plain: true}) { Plain }
				@button.Button(button.Props{Plain: true, Disabled: true}) { Disabled }
			</div>
		}

		@section("Tinted outline and plain", "Set a Variant on an outline or plain button and it takes that hue: the label and icon in the hue's -text token, and a light tint of the hue on hover. Leave Variant unset for the neutral style above. The last two post to /slow so you can see the spinner take the tint.") {
			<div class="space-y-4">
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Outline: true, Variant: button.VariantPrimary}) { Primary }
					@button.Button(button.Props{Outline: true, Variant: button.VariantAccent}) { Accent }
					@button.Button(button.Props{Outline: true, Variant: button.VariantDanger}) {
						@btnTrashIcon()
						Delete item
					}
					@button.Button(button.Props{Outline: true, Variant: button.VariantSuccess}) { Success }
					@button.Button(button.Props{Outline: true, Variant: button.VariantWarning}) { Warning }
					@button.Button(button.Props{Outline: true, Variant: button.VariantDanger, Disabled: true}) { Disabled }
				</div>
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Plain: true, Variant: button.VariantPrimary}) { Primary }
					@button.Button(button.Props{Plain: true, Variant: button.VariantAccent}) { Accent }
					@button.Button(button.Props{Plain: true, Variant: button.VariantDanger}) {
						@btnTrashIcon()
						Delete draft
					}
					@button.Button(button.Props{Plain: true, Variant: button.VariantSuccess}) { Success }
					@button.Button(button.Props{Plain: true, Variant: button.VariantWarning}) { Warning }
					@button.Button(button.Props{Plain: true, Variant: button.VariantDanger, Disabled: true}) { Disabled }
				</div>
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Outline: true, Variant: button.VariantDanger, Indicator: true, Attrs: templ.Attributes{
						"hx-post":    "/slow",
						"hx-target":  "#tint-out",
						"hx-disable": "this",
					}}) { Delete item }
					@button.Button(button.Props{Plain: true, Variant: button.VariantDanger, Indicator: true, Attrs: templ.Attributes{
						"hx-post":    "/slow",
						"hx-target":  "#tint-out",
						"hx-disable": "this",
					}}) { Delete draft }
					<div id="tint-out" class="text-sm text-muted-foreground"></div>
				</div>
			</div>
		}

		@section("As a link", "Pass Href and the button renders as an <a> with the same styling.") {
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{Variant: button.VariantAccent, Href: "#"}) { Learn more }
				@button.Button(button.Props{Outline: true, Href: "#"}) { Documentation }
			</div>
		}

		@section("htmx pass-through", "Extra attributes (hx-*, data-*, aria-*) are forwarded via Attrs. The button below posts to /echo and swaps the response into the sibling span.") {
			<div class="flex flex-wrap items-center gap-3">
				@button.Button(button.Props{
					Attrs: templ.Attributes{
						"hx-post":   "/echo",
						"hx-target": "#echo-out",
						"hx-swap":   "innerHTML",
					},
				}) {
					Ping
				}
				<div id="echo-out" class="text-sm text-muted-foreground"></div>
			</div>
		}
	</div>
}

templ btnTrashIcon() {
	<svg data-slot="icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
		<path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd"/>
	</svg>
}
