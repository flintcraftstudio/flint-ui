package table

// SortDirection is a column's current sort order. The zero value
// (SortNone) means the table isn't sorted by this column.
type SortDirection string

const (
	SortNone SortDirection = ""
	SortAsc  SortDirection = "asc"
	SortDesc SortDirection = "desc"
)

// ParseSortDirection reads a direction from a query parameter. Anything
// other than "asc" or "desc" is SortNone.
func ParseSortDirection(s string) SortDirection {
	switch SortDirection(s) {
	case SortAsc, SortDesc:
		return SortDirection(s)
	}
	return SortNone
}

// Next is the direction a click on this column should apply: an
// unsorted or descending column sorts ascending, an ascending one flips
// to descending.
func (d SortDirection) Next() SortDirection {
	if d == SortAsc {
		return SortDesc
	}
	return SortAsc
}

// SortHeaderProps controls a sortable column header.
//
// Href is the URL that applies this column's next sort — build it on the
// server with Direction.Next() so the link works without JS and can be
// bookmarked. Direction is the column's current sort (SortNone when the
// table is sorted by a different column).
//
// Attrs go on the <th>; LinkAttrs go on the <a>. For an in-place swap,
// put hx-get (same URL as Href), hx-target, and hx-push-url in LinkAttrs.
type SortHeaderProps struct {
	Href      string
	Direction SortDirection
	Bleed     bool
	Grid      bool
	Class     string
	Attrs     templ.Attributes
	LinkAttrs templ.Attributes
}

// SortHeader renders a <th> whose label is a link that re-sorts the table
// by this column. The current direction is shown with an arrow and
// exposed to assistive tech via aria-sort.
templ SortHeader(p SortHeaderProps) {
	<th
		class={ headerClasses(HeaderProps{Bleed: p.Bleed, Grid: p.Grid, Class: p.Class}) }
		if aria := ariaSort(p.Direction); aria != "" {
			aria-sort={ aria }
		}
		{ p.Attrs... }
	>
		<a href={ templ.SafeURL(p.Href) } class={ sortLinkClasses } { p.LinkAttrs... }>
			{ children... }
			<span class={ sortIconClasses(p.Direction) }>
				switch p.Direction {
					case SortAsc:
						<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="size-4">
							<path fill-rule="evenodd" d="M11.78 9.78a.75.75 0 0 1-1.06 0L8 7.06 5.28 9.78a.75.75 0 0 1-1.06-1.06l3.25-3.25a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd"></path>
						</svg>
					case SortDesc:
						<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="size-4">
							<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
						</svg>
					default:
						<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="size-4">
							<path fill-rule="evenodd" d="M5.22 10.22a.75.75 0 0 1 1.06 0L8 11.94l1.72-1.72a.75.75 0 1 1 1.06 1.06l-2.25 2.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 0 1 0-1.06ZM10.78 5.78a.75.75 0 0 1-1.06 0L8 4.06 6.28 5.78a.75.75 0 0 1-1.06-1.06l2.25-2.25a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd"></path>
						</svg>
				}
			</span>
		</a>
	</th>
}
