// Package documentation lives in doc.go.

package heading

// Level picks which HTML element to render (h1 .. h6). Zero value defers
// to the per-component default: Heading -> 1, Subheading -> 2.
type Level int

// Props is shared between Heading and Subheading.
type Props struct {
	Level Level
	Class string
	Attrs templ.Attributes
}

// Heading renders a page-level title. Defaults to <h1>.
templ Heading(p Props) {
	@element(resolveLevel(p.Level, 1), headingClasses(p), p.Attrs) {
		{ children... }
	}
}

// Subheading renders a section title. Defaults to <h2>.
templ Subheading(p Props) {
	@element(resolveLevel(p.Level, 2), subheadingClasses(p), p.Attrs) {
		{ children... }
	}
}

// element switches on the level and renders the matching HTML tag. templ
// doesn't support dynamic tag names, so this is the escape hatch.
templ element(level int, class string, attrs templ.Attributes) {
	switch level {
		case 1:
			<h1 class={ class } { attrs... }>
				{ children... }
			</h1>
		case 2:
			<h2 class={ class } { attrs... }>
				{ children... }
			</h2>
		case 3:
			<h3 class={ class } { attrs... }>
				{ children... }
			</h3>
		case 4:
			<h4 class={ class } { attrs... }>
				{ children... }
			</h4>
		case 5:
			<h5 class={ class } { attrs... }>
				{ children... }
			</h5>
		case 6:
			<h6 class={ class } { attrs... }>
				{ children... }
			</h6>
		default:
			<h1 class={ class } { attrs... }>
				{ children... }
			</h1>
	}
}
